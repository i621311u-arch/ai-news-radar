datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model Source {
  id                    String      @id @default(uuid())
  name                  String
  url                   String
  rssUrl                String?     @map("rss_url")
  type                  String      @default("primary") // primary, secondary, community
  credibilityTier       Int         @default(1) @map("credibility_tier")
  reliabilityScore      Int         @default(90) @map("reliability_score")
  pollingInterval       Int         @default(5) @map("polling_interval") // in minutes
  enabled               Boolean     @default(true)
  lastSuccessfulFetch  DateTime?   @map("last_successful_fetch")
  lastError             String?     @map("last_error")
  priority              Int         @default(50)
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  articles              Article[]
  fetchLogs             FetchLog[]

  @@map("sources")
}

model Article {
  id            String   @id @default(uuid())
  sourceId      String   @map("source_id")
  title         String
  url           String
  canonicalUrl  String?  @map("canonical_url")
  author        String?
  publishedAt   DateTime @map("published_at")
  fetchedAt     DateTime @default(now()) @map("fetched_at")
  description   String?
  content       String?
  imageUrl      String?  @map("image_url")
  contentHash   String   @map("content_hash")
  titleHash     String   @map("title_hash")
  language      String?  @default("en")
  rawMetadata   String?  @map("raw_metadata") // JSON string
  createdAt     DateTime @default(now()) @map("created_at")

  source        Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  eventArticles EventArticle[]

  @@index([url])
  @@index([contentHash])
  @@index([titleHash])
  @@map("articles")
}

model Event {
  id                 String   @id @default(uuid())
  canonicalTitle     String   @map("canonical_title")
  summary            String
  detailedSummary    String?  @map("detailed_summary")
  whyItMatters       String?  @map("why_it_matters")
  category           String   @default("Other") // Models, Research, Products, Agents, Open Source, Dev Tools, Infrastructure, Hardware, Robotics, Multimodal, Benchmarks, Safety, Security, Policy, Funding, Science, Industry, Other
  priority           String   @default("MEDIUM") // CRITICAL, HIGH, MEDIUM, LOW
  importanceScore    Int      @default(50) @map("importance_score")
  confidenceScore    Int      @default(50) @map("confidence_score")
  verificationStatus String   @default("UNVERIFIED") @map("verification_status") // CONFIRMED, MULTI_SOURCE_REPORTED, PRIMARY_SOURCE_ONLY, REPORTED, UNVERIFIED, CONTRADICTED
  firstSeenAt        DateTime @default(now()) @map("first_seen_at")
  lastUpdatedAt      DateTime @default(now()) @updatedAt @map("last_updated_at")
  primaryArticleId   String?  @map("primary_article_id")
  createdAt          DateTime @default(now()) @map("created_at")

  eventArticles      EventArticle[]
  claims             Claim[]

  @@index([priority])
  @@index([category])
  @@index([importanceScore])
  @@map("events")
}

model EventArticle {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  articleId String   @map("article_id")
  isPrimary Boolean  @default(false) @map("is_primary")
  addedAt   DateTime @default(now()) @map("added_at")

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([eventId, articleId])
  @@map("event_articles")
}

model Claim {
  id          String   @id @default(uuid())
  eventId     String   @map("event_id")
  claimText   String   @map("claim_text")
  claimType   String   @default("MEDIA_REPORT") @map("claim_type") // FACT, COMPANY_CLAIM, MEDIA_REPORT, SPECULATION, OPINION
  claimSource String?  @map("claim_source")
  evidenceUrl String?  @map("evidence_url")
  confidence  Int      @default(50)
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("claims")
}

model FetchLog {
  id           String   @id @default(uuid())
  sourceId     String   @map("source_id")
  status       String   // SUCCESS, ERROR
  itemsFetched Int      @default(0) @map("items_fetched")
  errorMessage String?  @map("error_message")
  timestamp    DateTime @default(now())

  source       Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@map("fetch_logs")
}

model DailyDigest {
  id          String   @id @default(uuid())
  digestDate  String   @unique @map("digest_date") // YYYY-MM-DD
  contentJson String   @map("content_json") // JSON string of digest
  sentAt      DateTime? @map("sent_at")
  status      String   @default("PENDING") // PENDING, SENT, FAILED

  @@map("daily_digests")
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}
